PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gtm_smartgate_demo
DB_USER=postgres
DB_PASSWORD=admin

# JWT Secrets — ROTATE BEFORE PRODUCTION
JWT_ACCESS_SECRET=CHANGEME_access_jwt_secret_key
JWT_REFRESH_SECRET=CHANGEME_refresh_jwt_secret_key
JWT_KIOSK_SECRET=CHANGEME_kiosk_jwt_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_KIOSK_EXPIRES_IN=12h

# Email (SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=YOUR_SENDGRID_API_KEY_HERE

# AWS S3
AWS_ACCESS_KEY_ID=YOUR_AWS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET
AWS_S3_BUCKET=gtm-smartgate-storage
AWS_REGION=ap-south-1

# Twilio OTP
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_TOKEN
